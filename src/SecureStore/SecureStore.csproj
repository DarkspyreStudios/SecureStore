<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Darkspyre.SecureStore</PackageId>
    <AssemblyName>SecureStore</AssemblyName>
    <Description>Operating system credential vault for .NET. One interface over macOS Keychain, Windows Credential Manager, and the Linux Secret Service, with in-memory and encrypted file stores for hosts that have no vault.</Description>
    <PackageTags>secrets;credentials;keychain;credential-manager;libsecret;keyring</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>
