<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Darkspyre.Encryption</PackageId>
    <AssemblyName>Darkspyre.Encryption</AssemblyName>
    <RootNamespace>Darkspyre.Encryption</RootNamespace>
    <Description>Encryption at rest for Darkspyre applications. Holds a vault root key, derives per-store subkeys, seals files in an authenticated envelope, and opens, locks and converts SQLCipher databases.</Description>
    <PackageTags>encryption;sqlcipher;aes-gcm;hkdf</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.core" />
    <PackageReference Include="SQLitePCLRaw.provider.dynamic_cdecl" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="SQLCIPHER-LICENSE.md" Pack="true" PackagePath="SQLCIPHER-LICENSE.md" />
  </ItemGroup>

</Project>
